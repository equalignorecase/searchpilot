# Use a dedicated Neon development branch; production uses a separate branch.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://YOUR_BRANCH.neonauth.REGION.aws.neon.tech/neondb/auth
# Generate separately: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
# The only username accepted by the application.
APP_USERNAME=
# Set automatically by npm run auth:owner. This immutable Neon user ID is required.
OWNER_NEON_USER_ID=
# Optional only for an existing Neon account; new installs use an internal identifier.
# OWNER_AUTH_EMAIL=
GOOGLE_GSC_CLIENT_ID=
GOOGLE_GSC_CLIENT_SECRET=
GOOGLE_GSC_REDIRECT_URI=https://localhost:3000/api/google/callback
# Exactly 32 random bytes, base64 encoded. Keep stable or reauthorize all tokens.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# At least 32 random characters; scheduler sends Authorization: Bearer <secret>.
CRON_SECRET=
NEXT_PUBLIC_APP_URL=https://localhost:3000
