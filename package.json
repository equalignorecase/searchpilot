{
  "name": "searchpilot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "dev:https": "bash scripts/dev-https.sh",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "worker": "node --conditions=react-server --import tsx src/jobs/worker.ts",
    "check:setup": "node --conditions=react-server --import tsx scripts/check-setup.ts",
    "setup": "bash scripts/setup.sh",
    "auth:owner": "bash scripts/create-owner.sh"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@neondatabase/auth": "0.7.0-beta",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-neon": "7.10.1",
    "googleapis": "190.0.0",
    "zod": "4.6.7",
    "recharts": "3.10.1",
    "@tanstack/react-table": "8.21.3",
    "lucide-react": "1.73.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "@radix-ui/react-slot": "1.5.0",
    "server-only": "0.0.1",
    "google-auth-library": "11.3.4"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "typescript": "5.9.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "@tailwindcss/postcss": "4.3.5",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "vitest": "5.1.0",
    "@playwright/test": "1.65.0",
    "tsx": "4.23.15",
    "dotenv": "18.0.10",
    "@electric-sql/pglite": "0.5.16",
    "vite": "8.3.8"
  }
}
