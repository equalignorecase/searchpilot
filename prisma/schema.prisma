generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
  schemas = ["public"]
}
enum DatasetType {
  SITE_DAILY
  QUERY_DAILY
  PAGE_DAILY
  QUERY_PAGE_DAILY
  @@schema("public")
}
enum JobStatus {
  QUEUED
  RUNNING
  RETRY
  SUCCEEDED
  FAILED
  @@schema("public")
}
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  DISMISSED
  @@schema("public")
}
enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  @@schema("public")
}
model GoogleCredential {
  id String @id @default(cuid())
  ownerId String @unique
  googleAccountId String?
  encryptedRefreshToken String
  grantedScopes String[]
  tokenStatus String @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@schema("public")
}
model Site {
  id String @id @default(cuid())
  ownerId String
  siteUrl String
  displayName String
  permission String
  propertyType String
  isDefault Boolean @default(false)
  lastSyncAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  recentSnapshots RecentSearchSnapshot[]
  metrics SearchMetric[]
  jobs SyncJob[]
  opportunities Opportunity[]
  tasks SeoTask[]
  targets PageTarget[]
  changes SeoChange[]
  inspections UrlInspection[]
  ruleConfig Json?
  @@unique([ownerId, siteUrl])
  @@index([ownerId, isDefault])
  @@schema("public")
}
model SearchMetric {
  id String @id @default(cuid())
  siteId String
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  date DateTime @db.Date
  datasetType DatasetType
  searchType String @default("web")
  dimensionKey String
  query String?
  page String?
  clicks Float
  impressions Float
  ctr Float
  position Float
  syncedAt DateTime @default(now())
  @@unique([siteId, date, datasetType, searchType, dimensionKey])
  @@index([siteId, datasetType, date])
  @@schema("public")
}
model SyncJob {
  id String @id @default(cuid())
  siteId String
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  syncType String
  status JobStatus @default(QUEUED)
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  attempts Int @default(0)
  checkpoint Json
  errorCode String?
  errorMessage String?
  startedAt DateTime?
  finishedAt DateTime?
  createdAt DateTime @default(now())
  availableAt DateTime @default(now())
  leaseUntil DateTime?
  leaseToken String?
  truncated Boolean @default(false)
  staged MetricStage[]
  @@index([status, availableAt, leaseUntil])
  @@index([siteId, createdAt])
  @@schema("public")
}
model MetricStage {
  jobId String
  job SyncJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  dimensionKey String
  query String?
  page String?
  clicks Float
  impressions Float
  ctr Float
  position Float
  @@id([jobId, dimensionKey])
  @@schema("public")
}
model Opportunity {
  id String @id @default(cuid())
  siteId String
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  type String
  fingerprint String
  query String?
  page String?
  score Int
  confidence Float
  evidence Json
  explanation String
  nextAction String
  status String @default("OPEN")
  detectedAt DateTime @default(now())
  tasks SeoTask[]
  @@unique([siteId, fingerprint])
  @@index([siteId, status, score])
  @@schema("public")
}
model SeoTask {
  id String @id @default(cuid())
  siteId String
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  title String
  description String @default("")
  page String?
  query String?
  priority Priority @default(MEDIUM)
  status TaskStatus @default(TODO)
  completedAt DateTime?
  createdAt DateTime @default(now())
  @@index([siteId, status, priority])
  @@schema("public")
}
model PageTarget {
  id String @id @default(cuid())
  siteId String
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  page String
  pageKey String
  pageType String @default("Other")
  targetKeyword String?
  notes String @default("")
  @@unique([siteId, pageKey])
  @@schema("public")
}
model SeoChange {
  id String @id @default(cuid())
  siteId String
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  page String
  title String
  description String
  changedAt DateTime
  @@index([siteId, changedAt])
  @@schema("public")
}
model UrlInspection {
  id String @id @default(cuid())
  siteId String
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  page String
  verdict String?
  coverage String?
  rawResult Json
  inspectedAt DateTime @default(now())
  @@index([siteId, inspectedAt])
  @@schema("public")
}
model OAuthState {
  hash String @id
  ownerId String
  verifier String
  expiresAt DateTime
  @@index([expiresAt])
  @@schema("public")
}
model RateLimit {
  key String @id
  count Int
  expiresAt DateTime
  @@index([expiresAt])
  @@schema("public")
}

model RecentSearchSnapshot {
  id String @id @default(cuid())
  siteId String
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  day DateTime @db.Date
  data Json?
  fetchedAt DateTime?
  leaseToken String?
  leaseUntil DateTime?
  retryAt DateTime?
  errorMessage String?
  @@unique([siteId, day])
  @@schema("public")
}
